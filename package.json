{
  "name": "unity-explorer",
  "displayName": "Unity Explorer",
  "description": "Unity Asset Tree, Meta File Sync & Rider-style Search Engine for Antigravity IDE, VS Code, and Cursor",
  "version": "1.2.6",
  "publisher": "danielsarabuna",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsarabuna/unity-explorer"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "unity",
    "gamedev",
    "meta-sync",
    "explorer",
    "rider",
    "treeview",
    "csharp"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build-fast",
    "build-fast": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "test:unit": "vitest run",
    "test:integration": "vscode-test",
    "test": "npm run lint && npm run test:unit",
    "package": "vsce package --no-dependencies"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "unityExplorerContainer",
          "title": "Unity Explorer",
          "icon": "resources/icons/unity-logo.svg"
        }
      ]
    },
    "views": {
      "unityExplorerContainer": [
        {
          "id": "unityExplorer",
          "name": "Unity Project",
          "type": "tree"
        }
      ]
    },
    "configuration": {
      "title": "Unity Explorer",
      "properties": {
        "unityExplorer.autoSyncMeta": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rename, move, and delete .meta files alongside assets."
        },
        "unityExplorer.showMetaFiles": {
          "type": "boolean",
          "default": false,
          "description": "Display raw .meta files in the explorer tree."
        },
        "unityExplorer.showLogs": {
          "type": "boolean",
          "default": false,
          "description": "Display Unity engine Logs/ folder."
        },
        "unityExplorer.showLibrary": {
          "type": "boolean",
          "default": false,
          "description": "Display Unity cache Library/ folder."
        },
        "unityExplorer.showTemp": {
          "type": "boolean",
          "default": false,
          "description": "Display Unity build Temp/ folder."
        },
        "unityExplorer.showPackages": {
          "type": "boolean",
          "default": true,
          "description": "Display Unity Packages in the explorer tree."
        },
        "unityExplorer.showProjectSettings": {
          "type": "boolean",
          "default": true,
          "description": "Display ProjectSettings in the explorer tree."
        }
      }
    },
    "commands": [
      {
        "command": "unityExplorer.searchEverywhere",
        "title": "Unity: Search Everywhere",
        "icon": "$(search)"
      },
      {
        "command": "unityExplorer.toggleVisibility",
        "title": "Toggle Explorer Visibility Settings",
        "icon": "$(filter)"
      },
      {
        "command": "unityExplorer.switchViewMode",
        "title": "Switch View Mode",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "unityExplorer.createScript",
        "title": "New C# Script",
        "icon": "$(add)"
      },
      {
        "command": "unityExplorer.refresh",
        "title": "Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "unityExplorer.searchTypes",
        "title": "Unity: Search Types",
        "icon": "$(symbol-class)"
      },
      {
        "command": "unityExplorer.searchMembers",
        "title": "Unity: Search Members",
        "icon": "$(symbol-field)"
      },
      {
        "command": "unityExplorer.searchFiles",
        "title": "Unity: Search Files",
        "icon": "$(file)"
      },
      {
        "command": "unityExplorer.createFolder",
        "title": "New Folder",
        "icon": "$(folder-active)"
      },
      {
        "command": "unityExplorer.createShader",
        "title": "New Shader",
        "icon": "$(file-code)"
      },
      {
        "command": "unityExplorer.createMaterial",
        "title": "New Material",
        "icon": "$(color-mode)"
      },
      {
        "command": "unityExplorer.createAsmdef",
        "title": "New Assembly Definition",
        "icon": "$(extensions)"
      },
      {
        "command": "unityExplorer.rename",
        "title": "Rename Asset (with .meta sync)",
        "icon": "$(edit)"
      },
      {
        "command": "unityExplorer.delete",
        "title": "Delete Asset (with .meta sync)",
        "icon": "$(trash)"
      },
      {
        "command": "unityExplorer.revealInFinder",
        "title": "Reveal in Finder / Explorer",
        "icon": "$(folder-opened)"
      }
    ],
    "keybindings": [
      {
        "command": "unityExplorer.searchEverywhere",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+f",
        "when": "unityExplorer:isUnityProject"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "unityExplorer.searchEverywhere",
          "when": "view == unityExplorer",
          "group": "navigation@1"
        },
        {
          "command": "unityExplorer.toggleVisibility",
          "when": "view == unityExplorer",
          "group": "navigation@2"
        },
        {
          "command": "unityExplorer.switchViewMode",
          "when": "view == unityExplorer",
          "group": "navigation@3"
        },
        {
          "command": "unityExplorer.createScript",
          "when": "view == unityExplorer",
          "group": "navigation@4"
        },
        {
          "command": "unityExplorer.refresh",
          "when": "view == unityExplorer",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "unityExplorer.createScript",
          "when": "view == unityExplorer && (viewItem == unityFolder || viewItem == unityAssetsRoot)",
          "group": "1_create@1"
        },
        {
          "command": "unityExplorer.createFolder",
          "when": "view == unityExplorer && (viewItem == unityFolder || viewItem == unityAssetsRoot)",
          "group": "1_create@2"
        },
        {
          "command": "unityExplorer.createShader",
          "when": "view == unityExplorer && (viewItem == unityFolder || viewItem == unityAssetsRoot)",
          "group": "1_create@3"
        },
        {
          "command": "unityExplorer.createMaterial",
          "when": "view == unityExplorer && (viewItem == unityFolder || viewItem == unityAssetsRoot)",
          "group": "1_create@4"
        },
        {
          "command": "unityExplorer.createAsmdef",
          "when": "view == unityExplorer && (viewItem == unityFolder || viewItem == unityAssetsRoot)",
          "group": "1_create@5"
        },
        {
          "command": "unityExplorer.rename",
          "when": "view == unityExplorer && (viewItem == unityAsset || viewItem == unityFolder)",
          "group": "2_modify@1"
        },
        {
          "command": "unityExplorer.delete",
          "when": "view == unityExplorer && (viewItem == unityAsset || viewItem == unityFolder)",
          "group": "2_modify@2"
        },
        {
          "command": "unityExplorer.revealInFinder",
          "when": "view == unityExplorer && (viewItem == unityAsset || viewItem == unityFolder || viewItem == unityAssetsRoot)",
          "group": "3_utility@1"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
